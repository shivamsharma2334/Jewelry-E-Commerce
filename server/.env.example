# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGO_DB_NAME=jewellery-db

# Strong random secrets, 32+ chars each and different
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
REFRESH_SECRET=replace-with-a-different-long-random-secret-at-least-32-chars

# Google OAuth Web Client ID
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Frontend origin(s), comma-separated
FRONTEND_URL=https://your-project.vercel.app
NODE_ENV=production

# Email verification / password reset (Resend)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=ShivAmbar Jewels <no-reply@yourdomain.com>

# Payments
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxx
CURRENCY=INR

# Commerce
FREE_SHIPPING_THRESHOLD=5000
SHIPPING_FEE=199
TAX_RATE=0.03
