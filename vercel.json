{
  "buildCommand": "npm --prefix Frontend ci --no-audit --no-fund && npm --prefix Frontend run build",
  "outputDirectory": "Frontend/dist",
  "framework": "vite",
  "functions": { "api/index.js": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
